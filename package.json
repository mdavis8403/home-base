{
  "name": "home-base",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/local.ts",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "check": "npm test && npm run test:mysteries && npm run typecheck && npm run lint && npm run build:cloudflare && npm run test:e2e",
    "test:mysteries": "node --import tsx scripts/validate-mysteries.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "tsx scripts/local.ts --preview",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "image-size": "^2.0.2",
    "mediabunny": "^1.56.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "miniflare": "^5.20260908.0-alpha",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
