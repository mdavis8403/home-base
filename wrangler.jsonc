{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-base",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-base-db",
      "migrations_dir": "db/d1",
    },
  ],
  "r2_buckets": [
    { "binding": "FAMILY_MEDIA", "bucket_name": "home-base-private-media" },
  ],
  "vars": {
    "APP_ORIGIN": "https://mdhomebase.com",
    "FAMILY_TIMEZONE": "America/Chicago",
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 30000 },
}
