# Server-only. Copy to .env.local. Never commit real credentials.
DATABASE_URL=postgresql://homebase:local-development-only@localhost:5432/homebase
APP_ORIGIN=http://localhost:3000
# Initial setup only. Use an 8–256 character family phrase. Profiles have no passwords.
FAMILY_ACCESS_PHRASE=
# Optional separate 12–256 character administration key, different from the family phrase.
# Required only for sensitive parent actions, never for profile selection.
ADMIN_ACCESS_KEY=
FAMILY_TIMEZONE=America/Chicago
# Required for Messages attachments. Bucket must remain PRIVATE.
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server must have FFmpeg/ffprobe installed; optional explicit executable path.
FFPROBE_PATH=ffprobe
