# Server-only. Copy to .env.local. Never commit real credentials.
DATABASE_URL=postgresql://homebase:local-development-only@localhost:5432/homebase
APP_ORIGIN=http://localhost:3000
# Initial setup only. Use a long family phrase and distinct 6+ digit PINs/passcodes.
FAMILY_ACCESS_PHRASE=
MIA_PASSCODE=
MOM_PASSCODE=
DAD_PASSCODE=
FAMILY_TIMEZONE=America/Chicago
# Optional until media features are built. Bucket must remain PRIVATE.
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
